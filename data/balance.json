		"max": 4,
		"scatter": 1.6,
		"max_on_map": 300
	},

	"fuel": {
		"_comment": "燃料の単位は『動作秒数』。燃料缶1個で per_can 秒ぶん補給される。給油所では無料で受け取れる。機械に乗ったまま給油所に入ると station_refuel_per_sec ずつ補給される",
		"per_can": 20,
		"station_refuel_per_sec": 15
	},

