	"lumberjack": {
		"_comment": "伐採員は役割ごとに動く。chop = 木を切って丸太を落とす / haul = 落ちている丸太を拾って製材所へ運ぶ",
		"_capacity_note": "積載量は強化の lumberjack_capacity、1回のダメージは強化の lumberjack_axe で決まる",
		"pickup_radius": 1.5,
		"move_speed": 3.2,
				"chop_interval": 0.6
	},

	"sawmill": {
		"_comment": "丸太置き場・出口に置ける数に上限はない。pad_radius = 受け渡しの枠の半径",
		"pad_radius": 1.6
	},

	"dock": {
		"_comment": "出荷場の枠に置いた板と丸太は、強化『出荷のペース』の個/秒で販売のトラックに積まれる。置ける数に上限はない。丸太は丸太の売値（板の半値）で売れる",
		"_truck_note": "トラック1台に積める数は強化『販売のトラック』（乗り物タブ）。同じ強化で走る速さも truck_speed + truck_speed_per_level x Lv になる。満載か、積む物が depart_idle_sec 秒無くなると代金が入って走り去り、空のトラックが戻る",
		"depart_idle_sec": 2.5,
		"truck_speed": 9.0,
		"truck_speed_per_level": 1.0
	},

	"workshop": {
		"_comment": "工房（出荷場の右隣）。強化『工房』Lv1で開放。出荷場に置かれた板（炭は若木の丸太）のうち、作る品に使う木を工房のコンベアで受け取り、count 個で1つの品を作る。できた品は販売のトラックで売れる",
		"_name_note": "name の {tree} は木の名前に置き換わる（山によって木の名前が変わるため）",
		"_price_note": "品の売値 = count x 材料の売値 x price_mult。作る時間 = time / 強化『工房』の個/秒。input_cap = 工房に溜めておく材料の上限（超えた分は出荷場で待つ）",
		"input_cap": 12,
		"feed_rate": 2.0,
		"recipes": [
			{ "id": "charcoal", "name": "炭",               "tree": "sapling", "input": "log",   "count": 2, "price_mult": 2.4, "time": 0.6 },
			{ "id": "shelf",    "name": "{tree}の棚",       "tree": "pine",    "input": "plank", "count": 2, "price_mult": 1.8, "time": 1.0 },
			{ "id": "chair",    "name": "{tree}の椅子",     "tree": "maple",   "input": "plank", "count": 2, "price_mult": 1.8, "time": 1.2 },
			{ "id": "table",    "name": "{tree}のテーブル", "tree": "oak",     "input": "plank", "count": 3, "price_mult": 1.8, "time": 1.6 },
			{ "id": "chest",    "name": "{tree}のたんす",   "tree": "ebony",   "input": "plank", "count": 3, "price_mult": 1.8, "time": 2.0 }
		]
	},

	"prestige": {
		"_comment": "別の山へ移る（周回）。いまの山のエリアをすべて開放すると、親方タブから新しい山へ移れる。お金・強化・機械・エリア・評判・注文・在庫は最初からになり、親方の腕前（点）をもらう",
		"_points_note": "もらえる腕前 = points_base + 評判 x points_per_rep（切り捨て）。腕前は perks（ずっと残る強化）に使う。次のレベルの値段 = cost + レベル x cost_step 点",
		"_perk_note": "perks の値 = base + per_level x レベル。appraise = 売値の倍率、capital = 新しい山の最初の所持金、apprentice = 最初からいる伐採員、blade = 製材と工房の速さの倍率、regulars = 注文の割増に足す値、fame = 注文で上がる評判の倍率",
		"points_base": 3,
		"points_per_rep": 0.1,
		"repeat_price_growth": 1.25,
		"perks": [
			{ "id": "appraise",   "name": "目利き",     "desc": "すべての売値が上がる",               "base": 1.0, "per_level": 0.1,  "unit": "倍", "decimals": 1, "max_level": 10, "cost": 1, "cost_step": 1 },
			{ "id": "capital",    "name": "元手",       "desc": "新しい山を、この所持金から始める",     "base": 0,   "per_level": 1000, "unit": "円", "decimals": 0, "max_level": 10, "cost": 1, "cost_step": 1 },
			{ "id": "apprentice", "name": "弟子",       "desc": "新しい山に伐採員を連れていく",         "base": 0,   "per_level": 1,    "unit": "人", "decimals": 0, "max_level": 3,  "cost": 2, "cost_step": 2 },
			{ "id": "blade",      "name": "刃の手入れ", "desc": "製材所と工房が速くなる",               "base": 1.0, "per_level": 0.15, "unit": "倍", "decimals": 2, "max_level": 10, "cost": 1, "cost_step": 1 },
			{ "id": "regulars",   "name": "顔なじみ",   "desc": "注文の代金の割増が増える",             "base": 0,   "per_level": 0.1,  "unit": "",   "decimals": 1, "max_level": 5,  "cost": 1, "cost_step": 1 },
			{ "id": "fame",       "name": "名声",       "desc": "注文で上がる評判が増える",             "base": 1.0, "per_level": 0.25, "unit": "倍", "decimals": 2, "max_level": 4,  "cost": 2, "cost_step": 1 }
		]
	},

