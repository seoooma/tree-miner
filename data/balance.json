	"_comment": "ゲームバランスの設定ファイル。数値を変えるだけで調整できます。詳細は README の『バランス調整』を参照。",

	"economy": {
		"start_money": 0,
		"price_per_hardness": 1.0,
		"plank_multiplier": 2.0
	},

	"player": {
		"_comment": "chop_windup: 木に近づいてから最初に斧を振るまでの秒数。chop_interval: 1振りの間隔（斧は振り下ろした瞬間に当たる）",
		"chop_windup": 0.2,
		"chop_interval": 0.7,
		"chop_range": 1.3,
		"pickup_radius": 1.8,
		"board_range": 3.0,
		"transfer_interval": 0.08
	},

	"drops": {
		"_comment": "木を倒すと min〜max 本の丸太が周囲に散らばる。max_on_map を超えると新しく落ちない",
		"min": 2,
		"max": 4,
		"scatter": 1.6,
		"max_on_map": 300
	},

	"fuel": {
		"_comment": "燃料の単位は『動作秒数』。燃料缶1個で per_can 秒ぶん補給される。給油所では無料で受け取れる。機械に乗ったまま給油所に入ると station_refuel_per_sec ずつ補給される",
		"per_can": 20,
		"station_refuel_per_sec": 15
	},

	"machines": {
		"_comment": "ランクごとの性能と価格。ほかの強化と同じく強化画面のカードで買う（Lv = ランク）。次のランクを買うと既存の機械がそのランクに上がる。stat / unit = カードに出す代表の性能",
		"harvester": {
			"name": "伐採機",
			"desc": "Lv1で購入。乗ると木を自動で切る。以降は速さ・伐採力・燃料タンクが上がる",
			"stat": "chop_power", "unit": "",
			"ranks": [
				{ "name": "伐採機 Mk1", "cost": 600,   "speed": 5.5, "chop_power": 3,  "chop_interval": 0.35, "chop_range": 2.0, "fuel_max": 60,  "color": "#e8b030", "model": "yellow" },
				{ "name": "伐採機 Mk2", "cost": 4000,  "speed": 6.5, "chop_power": 8,  "chop_interval": 0.30, "chop_range": 2.4, "fuel_max": 90,  "color": "#e07a30", "model": "red" },
				{ "name": "伐採機 Mk3", "cost": 25000, "speed": 7.5, "chop_power": 20, "chop_interval": 0.25, "chop_range": 2.8, "fuel_max": 120, "color": "#d04040", "model": "purple" }
			]
		},
		"hauler": {
			"name": "運搬車",
			"desc": "Lv1で購入。乗ると落ちた丸太を拾って運ぶ。以降は速さ・積載量・燃料タンクが上がる",
			"stat": "capacity", "unit": "本",
			"ranks": [
				{ "name": "運搬車 Mk1", "cost": 500,   "speed": 7.0, "capacity": 20, "pickup_radius": 2.5, "fuel_max": 60,  "color": "#4a90d0", "model": "green" },
				{ "name": "運搬車 Mk2", "cost": 3500,  "speed": 8.0, "capacity": 40, "pickup_radius": 3.0, "fuel_max": 90,  "color": "#3a70c0", "model": "yellow" },
				{ "name": "運搬車 Mk3", "cost": 20000, "speed": 9.0, "capacity": 80, "pickup_radius": 3.5, "fuel_max": 120, "color": "#6a50c0", "model": "purple" }
			]
		}
	},

	"lumberjack": {
		"_comment": "伐採員は役割ごとに動く。chop = 木を切って丸太を落とす / haul = 落ちている丸太を拾って製材所へ運ぶ",
		"_capacity_note": "積載量は強化の lumberjack_capacity で決まる",
		"pickup_radius": 1.5,
		"move_speed": 3.2,
		"axe_power": 1.0,
		"chop_interval": 0.6
	},

	"sawmill": {
		"_comment": "丸太置き場・出口に置ける数に上限はない。pad_radius = 受け渡しの枠の半径",
		"pad_radius": 1.6
	},

	"dock": {
		"_comment": "出荷場に置いた板と、隣の『丸太を売る』枠に置いた丸太は、強化『出荷のペース』の個/秒で販売のトラックに積まれる。置ける数に上限はない。丸太は丸太の売値（板の半値）で売れる",
		"_truck_note": "トラック1台に積める数 = max(truck_min_capacity, 出荷のペース x truck_load_sec)。満載か、積む物が depart_idle_sec 秒無くなると代金が入って走り去り、すぐ空のトラックが戻る",
		"truck_load_sec": 10,
		"truck_min_capacity": 12,
		"depart_idle_sec": 2.5
	},

